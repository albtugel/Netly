# Copy to .env and adjust. .env is git-ignored; docker compose reads it automatically.

# Budget Service: PostgreSQL connection. Compose overrides DB_HOST/DB_PORT/DB_NAME
# with the internal `postgres` container; these values are for `swift run` on the host.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=netly_budget
DB_USER=netly
DB_PASSWORD=netly
# DB_SSLMODE=require

# HS256 key shared by Profile Service and Budget Service, at least 32 bytes.
JWT_SECRET=netly-dev-jwt-secret-change-me-32bytes

# Budget Service HTTP port.
PORT=8082
